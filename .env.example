# netwatch configuration — copy to `.env` and edit for your network.
#   cp .env.example .env
#
# `.env` is gitignored so your LAN specifics never get committed. docker-compose
# auto-loads it; for the desktop subscriber, ntfy-toast.sh sources it if present.

# --- netwatch service (docker-compose / systemd) ---

# Seconds between probe cycles.
NETWATCH_INTERVAL=5

# ntfy topic URL for phone push alerts. Leave blank to disable. Point it at a
# LAN-hosted ntfy server — an internet service can't alert you the internet is
# down. Example: http://192.168.1.100:8090/internet-alerts
NETWATCH_NTFY_URL=

# --- web dashboard (docker compose up -d --build web) ---

# Where the netwatch data dir lives on the host. Default ./data matches the
# compose-run netwatch; a systemd deployment writes to ~/.local/share/netwatch
# — use an absolute path here (compose does not expand ~).
NETWATCH_DATA_DIR=./data

# Host port for the dashboard.
NETWATCH_WEB_PORT=8091

# Used to render copy-pasteable fix commands in the playbooks (e.g.
# `nmcli device reapply <iface>`). Leave blank for generic placeholders.
NETWATCH_WEB_IFACE=
NETWATCH_WEB_LAN_DNS=

# --- desktop subscriber (subscribers/ntfy-toast.sh / .ps1 / .service) ---

# Base URL of your LAN ntfy server.
NTFY_SERVER=http://192.168.1.100:8090

# Topic to subscribe to (must match the topic in NETWATCH_NTFY_URL).
NTFY_TOPIC=internet-alerts
